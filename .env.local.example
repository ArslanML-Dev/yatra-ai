# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real keys.

# Fallback Nearby Essentials data source, used only when the free public
# Overpass mirror (the primary source) is unreachable. Sign up free at
# https://locationiq.com (no credit card required) — 5,000 requests/day,
# 2 requests/second. Without this set, Nearby Essentials still works
# normally via Overpass; it just has no fallback during an Overpass outage.
LOCATIONIQ_API_KEY=
